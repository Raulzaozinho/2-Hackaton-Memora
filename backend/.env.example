# Só a máquina do telão precisa deste arquivo. Copie para ".env" (sem o .example) e preencha.
# No painel do Supabase: Connect > Session pooler. A URL começa com jdbc:postgresql://
SUPABASE_DB_URL=jdbc:postgresql://aws-0-REGIAO.pooler.supabase.com:5432/postgres
SUPABASE_DB_USER=postgres.CODIGO_DO_PROJETO
SUPABASE_DB_PASSWORD=

# O PIN do painel da organização (o padrão é "feira").
FEIRA_PIN=feira
